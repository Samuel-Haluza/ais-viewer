<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.ukf.aisviewer.controller.CreditsController" fitToWidth="true" styleClass="tab-scroll, page-credits">
    <VBox spacing="24" styleClass="tab-content">
        <padding><Insets bottom="24" left="24" right="24" top="20" /></padding>

        <Label styleClass="page-title" text="Kredity a priemer" />

        <!-- Súhrn: riadok čísel ako vo výkaze -->
        <HBox alignment="BOTTOM_LEFT" spacing="40">
            <VBox spacing="2" styleClass="total-card">
                <Label styleClass="credit-card-label" text="Získané spolu" />
                <Label fx:id="totalCreditsLabel" styleClass="credit-card-value" text="-" />
            </VBox>
            <VBox spacing="2" styleClass="mandatory-card">
                <Label styleClass="credit-card-label" text="Povinné" />
                <Label fx:id="mandatoryCreditsTotal" styleClass="credit-card-value" text="-" />
            </VBox>
            <VBox spacing="2" styleClass="optional-card">
                <Label styleClass="credit-card-label" text="Povinne voliteľné" />
                <Label fx:id="optionalCreditsTotal" styleClass="credit-card-value" text="-" />
            </VBox>
            <VBox spacing="2" styleClass="elective-card">
                <Label styleClass="credit-card-label" text="Výberové" />
                <Label fx:id="electiveCreditsTotal" styleClass="credit-card-value" text="-" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox spacing="2" styleClass="avg-card">
                <Label styleClass="credit-card-label" text="Vážený priemer, celé štúdium" />
                <Label fx:id="avgGradeLabel" styleClass="credit-card-value-large" text="-" />
            </VBox>
            <VBox spacing="2" styleClass="avg-card">
                <Label fx:id="yearAvgHintLabel" styleClass="credit-card-label" text="Vážený priemer, vybraný ročník" />
                <Label fx:id="yearAvgGradeLabel" styleClass="credit-card-value-large" text="-" />
            </VBox>
        </HBox>

        <VBox spacing="8" styleClass="credit-card">
            <padding><Insets top="14" /></padding>
            <HBox alignment="BASELINE_LEFT" spacing="12">
                <Label styleClass="group-title" text="Postup k ukončeniu štúdia" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="graduationCreditsLabel" styleClass="category-value" text="-" />
                <Label fx:id="graduationProgressLabel" styleClass="category-hint" text="-" />
            </HBox>
            <ProgressBar fx:id="graduationProgressBar" maxWidth="Infinity" progress="0.0" />
            <Label fx:id="graduationRemainingLabel" styleClass="category-hint" text="-" />
        </VBox>

        <HBox spacing="32">
            <VBox spacing="12" styleClass="credit-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
                <padding><Insets top="14" /></padding>
                <Label styleClass="group-title" text="Podľa kategórie" />
                <Label styleClass="status-label" text="Získané kredity oproti požiadavkám študijného plánu." wrapText="true" />
                <VBox fx:id="categoryBox" spacing="14" />
            </VBox>
            <VBox spacing="12" styleClass="credit-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="0">
                <padding><Insets top="14" /></padding>
                <Label styleClass="group-title" text="Po ročníkoch" />
                <Label styleClass="status-label" text="Získané kredity a vážený priemer v jednotlivých ročníkoch." wrapText="true" />
                <VBox fx:id="yearAveragesBox" spacing="0" />
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
