<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sk.ukf.aisviewer.controller.StudyPlanController"
            styleClass="tab-scroll">
    <VBox spacing="12" styleClass="tab-content">
        <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>
        <Label styleClass="group-title" text="Plánovanie štúdia"/>
        <HBox spacing="10">
            <Label text="Hlavný smer"/>
            <ComboBox fx:id="primaryDirectionCombo" prefWidth="240"/>
            <Label text="Vedľajší smer"/>
            <ComboBox fx:id="secondaryDirectionCombo" prefWidth="240"/>
        </HBox>
        <Label fx:id="statusLabel" styleClass="status-label"/>
        <Label fx:id="creditsLabel" styleClass="credit-card-label" wrapText="true"/>
        <Label styleClass="group-title" text="Povinné predmety"/>
        <TableView fx:id="mandatoryTable" prefHeight="170" styleClass="subject-table"/>
        <Label styleClass="group-title" text="Odporúčané predmety"/>
        <TableView fx:id="recommendationTable" prefHeight="230" styleClass="subject-table"/>
        <HBox spacing="8">
            <Button onAction="#addSelectedRecommendation" text="Pridať do plánu"/>
            <Button onAction="#showAllPvp" text="Zobraziť všetky PVP predmety"/>
        </HBox>
        <Label styleClass="group-title" text="Môj plán"/>
        <TableView fx:id="plannedTable" prefHeight="160" styleClass="subject-table"/>
        <Button onAction="#removeSelectedPlanned" text="Odstrániť vybraný predmet"/>
    </VBox>
</ScrollPane>
