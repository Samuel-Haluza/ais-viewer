<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.image.ImageView?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.ukf.aisviewer.controller.SubjectsController" fitToWidth="true" styleClass="tab-scroll, page-subjects">
    <VBox spacing="24" styleClass="tab-content">
        <padding><Insets bottom="24" left="24" right="24" top="20" /></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label styleClass="page-title" text="Predmety" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="field-label" text="Semester" />
            <ComboBox fx:id="semesterFilterCombo" accessibleText="Filter podľa semestra" prefWidth="170" />
        </HBox>

        <!-- Povinné predmety -->
        <VBox fx:id="mandatoryGroup" spacing="8" styleClass="subject-group, cat-mandatory">
            <HBox alignment="BASELINE_LEFT" spacing="12">
                <Label styleClass="group-title" text="Povinné predmety" />
                <Label fx:id="mandatoryCreditsLabel" styleClass="credits-badge, mandatory-badge" text="Kredity: 0" />
            </HBox>
            <TableView fx:id="mandatoryTable" styleClass="subject-table">
                <placeholder><Label text="Žiadne povinné predmety" /></placeholder>
            </TableView>
        </VBox>

        <!-- Povinne voliteľné predmety -->
        <VBox fx:id="optionalGroup" spacing="8" styleClass="subject-group, cat-optional">
            <HBox alignment="BASELINE_LEFT" spacing="12">
                <Label styleClass="group-title" text="Povinne voliteľné predmety" />
                <Label fx:id="optionalCreditsLabel" styleClass="credits-badge, optional-badge" text="Kredity: 0" />
            </HBox>
            <TableView fx:id="optionalTable" styleClass="subject-table">
                <placeholder><Label text="Žiadne povinne voliteľné predmety" /></placeholder>
            </TableView>
        </VBox>

        <!-- Výberové predmety -->
        <VBox fx:id="electiveGroup" spacing="8" styleClass="subject-group, cat-elective">
            <HBox alignment="BASELINE_LEFT" spacing="12">
                <Label styleClass="group-title" text="Výberové predmety" />
                <Label fx:id="electiveCreditsLabel" styleClass="credits-badge, elective-badge" text="Kredity: 0" />
            </HBox>
            <TableView fx:id="electiveTable" styleClass="subject-table">
                <placeholder><Label text="Žiadne výberové predmety" /></placeholder>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
