<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.image.ImageView?>

<BorderPane styleClass="main-root" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.ukf.aisviewer.controller.MainController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <padding><Insets bottom="10" left="16" right="16" top="10" /></padding>

            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="studentNameLabel" styleClass="top-name" text="Načítavam..." />
                <Label fx:id="studentProgramLabel" styleClass="top-program" text="" />
            </VBox>

            <VBox alignment="CENTER_RIGHT" spacing="1">
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <ProgressIndicator fx:id="syncProgressIndicator" managed="false" prefHeight="18" prefWidth="18" styleClass="sync-progress" visible="false" />
                    <Label fx:id="dataStatusLabel" managed="false" styleClass="top-sync-status" text="" visible="false" />
                </HBox>
                <Label fx:id="lastUpdatedLabel" managed="false" styleClass="top-last-updated" text="" visible="false" />
            </VBox>

            <Label styleClass="top-label" text="Zápisný list:" />
            <ComboBox fx:id="enrollmentListCombo" prefWidth="180" styleClass="enrollment-combo" />

            <Button fx:id="refreshButton" onAction="#handleRefresh" styleClass="refresh-button" text="Obnoviť údaje" />
            <Button onAction="#handleLogout" styleClass="logout-button" text="Odhlásiť" />
        </HBox>
    </top>

    <!-- Main Content: TabPane -->
    <center>
        <TabPane styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE">

            <!-- Tab 1: Predmety -->
            <Tab text="📚  Predmety">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="16" styleClass="tab-content">
                        <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="top-label" text="Semester:" />
                            <ComboBox fx:id="semesterFilterCombo" prefWidth="180" />
                        </HBox>

                        <!-- Povinné predmety -->
                        <VBox spacing="6" styleClass="subject-group">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label styleClass="group-title" text="Povinné predmety" />
                                <Label fx:id="mandatoryCreditsLabel" styleClass="credits-badge mandatory-badge" text="Kredity: 0" />
                            </HBox>
                            <TableView fx:id="mandatoryTable" prefHeight="200" styleClass="subject-table">
                                <placeholder><Label text="Žiadne povinné predmety" /></placeholder>
                            </TableView>
                        </VBox>

                        <!-- Povinne voliteľné predmety -->
                        <VBox spacing="6" styleClass="subject-group">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label styleClass="group-title" text="Povinne voliteľné predmety" />
                                <Label fx:id="optionalCreditsLabel" styleClass="credits-badge optional-badge" text="Kredity: 0" />
                            </HBox>
                            <TableView fx:id="optionalTable" prefHeight="200" styleClass="subject-table">
                                <placeholder><Label text="Žiadne povinne voliteľné predmety" /></placeholder>
                            </TableView>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- Tab 2: Skúšky -->
            <Tab text="📝  Skúšky">
                <VBox spacing="12" styleClass="tab-content">
                    <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                    <Label styleClass="group-title" text="Skúškové termíny" />
                    <Label fx:id="examsStatusLabel" styleClass="status-label" text="" visible="false" />
                    <TableView fx:id="examsTable" styleClass="subject-table" VBox.vgrow="ALWAYS">
                        <placeholder><Label text="Žiadne skúškové termíny" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 3: Kredity / Prehľady -->
            <Tab text="📊  Kredity">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox spacing="20" styleClass="tab-content">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                        <Label styleClass="group-title" text="Prehľad kreditov" />

                        <!-- Credit summary cards -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <!-- Total -->
                            <VBox alignment="CENTER" minWidth="140" spacing="4" styleClass="credit-card total-card">
                                <padding><Insets bottom="16" left="20" right="20" top="16" /></padding>
                                <Label styleClass="credit-card-label" text="Celkové kredity" />
                                <Label fx:id="totalCreditsLabel" styleClass="credit-card-value" text="-" />
                            </VBox>
                            <!-- Mandatory -->
                            <VBox alignment="CENTER" minWidth="140" spacing="4" styleClass="credit-card mandatory-card">
                                <padding><Insets bottom="16" left="20" right="20" top="16" /></padding>
                                <Label styleClass="credit-card-label" text="Povinné" />
                                <Label fx:id="mandatoryCreditsTotal" styleClass="credit-card-value" text="-" />
                            </VBox>
                            <!-- Optional -->
                            <VBox alignment="CENTER" minWidth="140" spacing="4" styleClass="credit-card optional-card">
                                <padding><Insets bottom="16" left="20" right="20" top="16" /></padding>
                                <Label styleClass="credit-card-label" text="Povinne voliteľné" />
                                <Label fx:id="optionalCreditsTotal" styleClass="credit-card-value" text="-" />
                            </VBox>

                           <!-- Grade average -->
                           <VBox alignment="CENTER_LEFT" maxWidth="300" spacing="4" styleClass="credit-card avg-card">
                               <padding>
                           <Insets bottom="16" left="20" right="20" top="16" />
                        </padding>
                               <Label styleClass="credit-card-label" text="Vážený priemer známok" />
                               <Label fx:id="avgGradeLabel" styleClass="credit-card-value-large" text="-" />
                               <Label styleClass="credit-card-label" text="Za celé štúdium" />
                           </VBox>
                           <VBox alignment="CENTER_LEFT" maxWidth="300" spacing="4" styleClass="credit-card avg-card">
                               <padding>
                           <Insets bottom="16" left="20" right="20" top="16" />
                        </padding>
                               <Label styleClass="credit-card-label" text="Vážený priemer podľa ročníka" />
                               <Label fx:id="yearAvgGradeLabel" styleClass="credit-card-value-large" text="-" />
                               <Label styleClass="credit-card-label" text="Podľa vybraného ročníka" />
                           </VBox>
                        </HBox>

                        <VBox spacing="12" styleClass="credit-card">
                            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                            <Label styleClass="group-title" text="🎓 Postup k ukončeniu štúdia" />
                            <Label fx:id="graduationCreditsLabel" styleClass="credit-card-value" text="-" />
                            <ProgressBar fx:id="graduationProgressBar" maxWidth="Infinity" progress="0.0" />
                            <Label fx:id="graduationProgressLabel" styleClass="credit-card-label" text="-" />
                            <Label fx:id="graduationRemainingLabel" styleClass="status-label" text="-" />
                        </VBox>

                        <VBox spacing="12">
                            <Label styleClass="group-title" text="📈 Kredity podľa kategórie" />
                            <PieChart fx:id="creditsByCategoryChart" legendVisible="true"
                                      prefHeight="300.0" prefWidth="600.0" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- Tab 4: Study Tree -->
            <Tab text="🌳  Môj študijný strom">
                <ScrollPane fitToWidth="true" styleClass="tab-scroll">
                    <VBox alignment="TOP_CENTER" spacing="16" styleClass="tab-content">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
                        <Label styleClass="group-title" text="🌳 Môj študijný strom" />
                        <Label fx:id="treePhaseLabel" styleClass="credit-card-value-large"
                               text="🌱 Semienko" />
                        <StackPane maxHeight="520" maxWidth="520" minHeight="420" minWidth="420">
                            <ImageView fx:id="treeBaseLayer" preserveRatio="true"
                                       fitWidth="500" fitHeight="500" smooth="true" />
                            <ImageView fx:id="treeBranchesLayer" opacity="0.15"
                                       preserveRatio="true" fitWidth="500" fitHeight="500"
                                       smooth="true" />
                            <ImageView fx:id="treeLeavesLayer" opacity="0"
                                       preserveRatio="true" fitWidth="500" fitHeight="500"
                                       smooth="true" />
                            <ImageView fx:id="treeFlowersLayer" opacity="0"
                                       preserveRatio="true" fitWidth="500" fitHeight="500"
                                       smooth="true" />
                            <ImageView fx:id="treeEffectsLayer" opacity="0"
                                       preserveRatio="true" fitWidth="500" fitHeight="500"
                                       smooth="true" />
                        </StackPane>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- Tab 5: Rozvrh -->
            <Tab text="🗓  Rozvrh">
                <VBox spacing="12" styleClass="tab-content">
                    <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label styleClass="group-title" text="Rozvrh" />
                        <Label fx:id="scheduleStatusLabel" styleClass="status-label" text="" visible="false" />
                    </HBox>
                    <!-- Legend -->
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="schedule-legend">
                        <HBox alignment="CENTER_LEFT" spacing="4">
                            <Label styleClass="legend-dot legend-lecture" />
                            <Label styleClass="legend-text" text="Prednáška" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="4">
                            <Label styleClass="legend-dot legend-seminar" />
                            <Label styleClass="legend-text" text="Cvičenie / Seminár" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="4">
                            <Label styleClass="legend-dot legend-other" />
                            <Label styleClass="legend-text" text="Ostatné" />
                        </HBox>
                    </HBox>
                    <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="schedule-scroll" VBox.vgrow="ALWAYS">
                        <VBox fx:id="scheduleContainer" styleClass="schedule-container" />
                    </ScrollPane>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
