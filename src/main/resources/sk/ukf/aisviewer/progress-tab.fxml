<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- Záložka „Môj pokrok“: hodnosť, štatistiky, úspechy a časová os semestrov.
     Väčšina obsahu sa vytvára v ProgressController podľa údajov z AIS. -->
<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sk.ukf.aisviewer.controller.ProgressController"
            fitToWidth="true" styleClass="tab-scroll, page-progress">
    <VBox spacing="24" styleClass="tab-content">
        <padding><Insets bottom="24" left="24" right="24" top="20" /></padding>

        <Label styleClass="page-title" text="Môj pokrok" />

        <!-- Hodnosť a XP – obsah vytvára ProgressController.showRank -->
        <VBox fx:id="rankPanel" spacing="18" styleClass="rank-card" />

        <!-- Štatistiky -->
        <HBox fx:id="statsBox" spacing="32" fillHeight="true" styleClass="section" />

        <!-- Najbližšie k splneniu -->
        <VBox spacing="12" styleClass="section">
            <Label styleClass="group-title" text="Najbližšie k splneniu" />
            <VBox fx:id="closestBox" spacing="12" />
        </VBox>

        <!-- Úspechy -->
        <VBox spacing="12" styleClass="section">
            <HBox alignment="BASELINE_LEFT" spacing="12">
                <Label styleClass="group-title" text="Úspechy" />
                <Label fx:id="achievementCountLabel" styleClass="status-label" text="" />
            </HBox>
            <HBox fx:id="filterBox" spacing="4" />
            <VBox fx:id="achievementsPane" spacing="24" />
        </VBox>

        <!-- Časová os -->
        <VBox spacing="12" styleClass="section">
            <Label styleClass="group-title" text="Časová os štúdia" />
            <HBox fx:id="timelineBox" alignment="TOP_LEFT" spacing="0" />
        </VBox>
    </VBox>
</ScrollPane>
